# Non-secret production contract. Copy outside Git and replace OPERATOR INPUT REQUIRED.
RELEASE_ID=git-OPERATOR_INPUT_REQUIRED
RUNTIME_UID=1000
RUNTIME_GID=1000
REGISTRY=registry.example.invalid
REGISTRY_NAMESPACE=operator/pryecip
API_IMAGE=registry.example.invalid/operator/pryecip/restaurant-api:git-OPERATOR_INPUT_REQUIRED
DINER_WEB_IMAGE=registry.example.invalid/operator/pryecip/restaurant-diner-web:git-OPERATOR_INPUT_REQUIRED
STAFF_WEB_IMAGE=registry.example.invalid/operator/pryecip/restaurant-staff-web:git-OPERATOR_INPUT_REQUIRED
CONNECTOR_IMAGE=registry.example.invalid/operator/pryecip/restaurant-local-connector:git-OPERATOR_INPUT_REQUIRED
INGRESS_IMAGE=registry.example.invalid/operator/pryecip/restaurant-ingress:git-OPERATOR_INPUT_REQUIRED

PUBLIC_ORIGIN=https://pilot.example.invalid
TRUSTED_HOSTS=pilot.example.invalid
HTTP_BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_BIND_ADDRESS=0.0.0.0
HTTPS_PORT=443
TLS_CERT_PATH=/operator/protected/tls/tls.crt
TLS_KEY_PATH=/operator/protected/tls/tls.key

APP_NAME=ECIP API
LOG_LEVEL=INFO
STAFF_LOGIN_RATE_LIMIT_PER_MINUTE=10
DINER_JOIN_RATE_LIMIT_PER_MINUTE=20
MYSQL_HOST=mysql.pilot.example.invalid
MYSQL_PORT=3306
MYSQL_DATABASE=ecip_pilot
MYSQL_USER=ecip_runtime
MYSQL_MIGRATION_USER=ecip_migrator
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_TTL_MINUTES=60
DINER_ACCESS_TOKEN_TTL_MINUTES=720
CONNECTOR_ACCESS_TOKEN_TTL_MINUTES=5
CONNECTOR_ENROLLMENT_TTL_MINUTES=15
CONNECTOR_CREDENTIAL_TTL_DAYS=365
PREPARATION_DISPATCH_CLAIM_LEASE_SECONDS=120
PASSWORD_MIN_LENGTH=12
FINKOK_ENVIRONMENT=demo
FINKOK_CONNECT_TIMEOUT_SECONDS=5
FINKOK_READ_TIMEOUT_SECONDS=20
METRICS_RETENTION=15d

# Paths only. Files must be mode 0600 and remain outside the repository.
MYSQL_PASSWORD_FILE=/operator/protected/secrets/mysql-runtime
MYSQL_MIGRATION_PASSWORD_FILE=/operator/protected/secrets/mysql-migration
AUTH_JWT_SECRET_FILE=/operator/protected/secrets/auth-jwt
DINER_ACCESS_SECRET_FILE=/operator/protected/secrets/diner-access

# External capability execution is hard-disabled in compose.production.yaml for WS-33-B.
# Provider, connector, registry, backup, and TLS credentials are never frontend variables.
