APP_NAME=ECIP API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ecip
MYSQL_USER=ecip
MYSQL_PASSWORD=local_development_only
MYSQL_ROOT_PASSWORD=local_root_development_only
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10

AUTH_JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_TTL_MINUTES=60
RESTAURANT_ACCESS_CODE_SECRET=replace_with_an_independent_random_secret_of_at_least_32_characters
DINER_ACCESS_TOKEN_TTL_MINUTES=720
CONNECTOR_ACCESS_TOKEN_TTL_MINUTES=5
CONNECTOR_ENROLLMENT_TTL_MINUTES=15
CONNECTOR_CREDENTIAL_TTL_DAYS=365
PREPARATION_DISPATCH_CLAIM_LEASE_SECONDS=120
PASSWORD_MIN_LENGTH=12

# Conekta is disabled by default. For the bounded TEST path, use
# compose.conekta-test.yaml and keep the private key in an external 0600 file.
CONEKTA_ENVIRONMENT=disabled
CONEKTA_CREDENTIAL_BINDING=pilot-location-conekta-test
CONEKTA_TEST_PRIVATE_KEY_FILE=/operator/protected/secrets/conekta-test-private-key

# Required only when running: python -m app.bootstrap_admin
BOOTSTRAP_TENANT_NAME=Development Tenant
BOOTSTRAP_TENANT_SLUG=development
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_bootstrap_password
