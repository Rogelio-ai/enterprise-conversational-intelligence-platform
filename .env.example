APP_NAME=ECIP API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ecip
MYSQL_USER=ecip
MYSQL_PASSWORD=local_development_only
MYSQL_ROOT_PASSWORD=local_root_development_only
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10

AUTH_JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_TTL_MINUTES=60
PASSWORD_MIN_LENGTH=12

# Required only when running: python -m app.bootstrap_admin
BOOTSTRAP_TENANT_NAME=Development Tenant
BOOTSTRAP_TENANT_SLUG=development
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_bootstrap_password
